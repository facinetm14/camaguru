### ----------------USERS--------------------------------

### check if a username is already used
@username = "blabla"

GET {{baseUrl}}/users/{{username}}/exists

### check if an email is already used
POST {{baseUrl}}/users/exists
content-type: application/json

{
  "email": "kskfkkf@gmail.com"
}

### upload image
POST {{baseUrl}}/users/images
Content-Type: application/json
Authorization: {{authToken}}

{
  "filename": "new-imagedd.jpg",
  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8Xw8AApMBgYj6aHsAAAAASUVORK5CYII="
}


### get all images
GET {{baseUrl}}/users/images
Content-Type: application/json
Authorization: {{authToken}}

### get image
@imageName = "blldsd.jpg"
GET {{baseUrl}}/users/images/{{imageName}}


### Like or dislike image
@imageId = xr7yma-mci04mbo-06g1d9
POST {{baseUrl}}/users/images/{{imageId}}/likes
Content-Type: application/json
Authorization: {{authToken}}


### GET image likes
GET {{baseUrl}}/users/images/{{imageId}}/likes
Content-Type: application/json
Authorization: {{authToken}}

### Comment Image
POST {{baseUrl}}/users/images/{{imageId}}/comment
Content-Type: application/json
Authorization: {{authToken}}

{
  "comment": "hello world"
}

### delete Image
DELETE  {{baseUrl}}/users/images/{{imageId}}
Content-Type: application/json
Authorization: {{authToken}}
